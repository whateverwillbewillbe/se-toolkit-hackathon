# PostgreSQL
POSTGRES_USER=grocery_user
POSTGRES_PASSWORD=grocery_secret
POSTGRES_DB=grocery_db
DATABASE_URL=postgresql+asyncpg://grocery_user:grocery_secret@db:5432/grocery_db

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Telegram Bot
TG_BOT_TOKEN=your_telegram_bot_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Модель с OpenRouter (бесплатные: google/gemma-2-9b-it:free, meta-llama/llama-3.3-8b-instruct:free и др.)
LLM_MODEL=qwen/qwen3.6-plus:free

# Frontend
VITE_API_URL=http://localhost:8000
DEFAULT_USER_ID=1
